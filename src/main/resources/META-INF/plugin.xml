<idea-plugin>
    <id>dev.farrun</id>
    <name>FarRun</name>
    <vendor>FarRun</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.plugins.gradle</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="FarRun Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>
        <configurationType implementation="dev.farrun.run.configuration.RunConfigurationType"/>
        <applicationConfigurable id="dev.farrun.settings.servers"
                                 parentId="tools"
                                 displayName="FarRun"
                                 instance="dev.farrun.settings.FarRunConfigurable"/>
    </extensions>

    <actions>
        <action id="dev.farrun.actions.FarRunHelloAction"
                class="dev.farrun.actions.HelloAction"
                text="FarRun: Hello"
                description="Show a FarRun integration notification">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
