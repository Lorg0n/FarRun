<idea-plugin>
    <id>dev.farrun</id>
    <name>FarRun</name>
    <vendor>FarRun</vendor>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="FarRun Notifications"
                           displayType="BALLOON"
                           isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="dev.farrun.actions.FarRunHelloAction"
                class="dev.farrun.actions.FarRunHelloAction"
                text="FarRun: Hello"
                description="Show a FarRun integration notification">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
